# Copie ce fichier en .env (ou renseigne ces variables dans le panneau de ton hébergeur)
# Turso : turso db create rami && turso db show rami --url && turso db tokens create rami
TURSO_DATABASE_URL=libsql://rami-votre-org.turso.io
TURSO_AUTH_TOKEN=
PORT=3001
NODE_ENV=production
# Seulement si le site et l'API sont sur deux domaines différents :
# CORS_ORIGIN=https://mon-site.com
